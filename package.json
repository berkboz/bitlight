{
  "name": "bitlight",
  "version": "0.1.0",
  "description": "Objects drawn in one bit, lit by your pointer. Ordered-dither 3D figures and scenes for the web, and an offline film renderer in the same look.",
  "keywords": [
    "dither",
    "1-bit",
    "illustration",
    "canvas",
    "sdf",
    "raymarching",
    "react",
    "pointer",
    "animation"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "default": "./src/core.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./figures/*": {
      "types": "./src/figure.d.ts",
      "default": "./src/figures/*.js"
    },
    "./global": "./dist/bitlight.global.js",
    "./package.json": "./package.json",
    "./props": {
      "types": "./src/props.d.ts",
      "default": "./src/props.js"
    },
    "./gpu": {
      "types": "./src/gpu.d.ts",
      "default": "./src/gpu.js"
    },
    "./image": {
      "types": "./src/image.d.ts",
      "default": "./src/image.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "look": "node look.mjs",
    "test": "node test/smoke.mjs",
    "check": "node build.mjs --check && node look.mjs --all && node film/check.mjs --all && node test/smoke.mjs",
    "film": "node film/check.mjs --film $npm_config_film && node film/render.mjs --film $npm_config_film && node film/score.mjs --film $npm_config_film && node film/mux.mjs --film $npm_config_film",
    "serve": "node serve.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "playwright": "1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkboz/bitlight.git"
  },
  "homepage": "https://berkboz.github.io/bitlight/",
  "bugs": {
    "url": "https://github.com/berkboz/bitlight/issues"
  }
}
